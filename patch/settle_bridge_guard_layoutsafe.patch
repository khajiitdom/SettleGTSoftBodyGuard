+	float SkyrimSystem::absorbDiscontinuity(float timeStep)
+	{
+		using Action = DiscontinuityGuard::Action;
+
+		const auto finding = GetDiscontinuityGuard(this).inspect(m_bones, rootTransform(), timeStep, GetDiscontinuitySettings());
