diff --git a/src/hdtDiscontinuityGuard.cpp b/src/hdtDiscontinuityGuard.cpp
new file mode 100644
index 0000000..db36229
--- /dev/null
+++ b/src/hdtDiscontinuityGuard.cpp
@@ -0,0 +1,129 @@
+#include "hdtDiscontinuityGuard.h"
+
+#include "hdtSkyrimBone.h"
+
+#include <mutex>
+#include <unordered_map>
+
+namespace hdt
+{
+	namespace
+	{
+		// A settling system is released once its pose has stayed calm for this long, so that a pose
+		// change which starts a moment after the system was built is still waited for.
+		constexpr float kCalmTime = 0.25f;
+	}
+
+	DiscontinuitySettings& GetDiscontinuitySettings()
+	{
+		static DiscontinuitySettings settings;
+		return settings;
+	}
+
+	DiscontinuityGuard& GetDiscontinuityGuard(const void* owner)
+	{
+		// Node-based map: references stay valid when other systems are added.
+		static std::mutex mutex;
+		static std::unordered_map<const void*, DiscontinuityGuard> guards;
+		std::lock_guard lock(mutex);
+		return guards[owner];
+	}
+
+	void DiscontinuityGuard::restart(const btTransform& root)
+	{
+		m_lastRoot = root;
+		m_tracking = true;
+	}
+
+	void DiscontinuityGuard::settle()
+	{
+		m_settling = true;
+		m_heldFor = 0.0f;
+		m_calmFor = 0.0f;
+	}
+
+	DiscontinuityGuard::Finding DiscontinuityGuard::inspect(const Bones& bones, const btTransform& root, float timeStep, const DiscontinuitySettings& settings)
+	{
+		Finding finding;
+
+		if (!settings.enabled) {
+			m_settling = false;
+		}
+		if (!m_tracking || !settings.enabled || timeStep <= FLT_EPSILON) {
+			restart(root);
+			return finding;
+		}
+
+		// Rigid motion of the root since the previous read.
+		const btTransform delta = root * m_lastRoot.inverse();
+		const btVector3 shift = root.getOrigin() - m_lastRoot.getOrigin();
+		m_lastRoot = root;
+
+		finding.rootSpeed = shift.length() / timeStep;
+		finding.turnSpeed = btDegrees(delta.getRotation().getAngleShortestPath()) / timeStep;
+
+		// What is left of each animated bone's motion once the root motion is taken out.
+		const float snapDistance = settings.poseSnapSpeedLimit * timeStep;
+		const float snapDistance2 = snapDistance * snapDistance;
+		float farthest2 = 0.0f;
+		for (const auto& bone : bones) {
+			if (!bone->m_rig.isStaticOrKinematicObject()) {
+				continue;
+			}
+
+			++finding.animatedBones;
+			const auto target = static_cast<const SkyrimBone*>(bone.get())->animatedRigOrigin();
+			const auto carried = delta * bone->m_rig.getWorldTransform().getOrigin();
+			const float moved2 = (target - carried).length2();
+			farthest2 = std::max(farthest2, moved2);
+			if (moved2 > snapDistance2) {
+				++finding.snappedBones;
+			}
+		}
+		finding.poseSpeed = std::sqrt(farthest2) / timeStep;
+
+		if (m_settling) {
+			m_heldFor += timeStep;
+			m_calmFor = finding.poseSpeed <= settings.settleSpeedLimit ? m_calmFor + timeStep : 0.0f;
+			finding.heldFor = m_heldFor;
+
+			if (m_calmFor < kCalmTime && m_heldFor < settings.settleTimeLimit) {
+				finding.action = Action::kHold;
+			} else {
+				m_settling = false;
+				finding.released = true;
+			}
+			return finding;
+		}
+
+		if (finding.snappedBones > 0 && finding.snappedBones * 2 >= finding.animatedBones) {
+			finding.action = Action::kRestart;
+		} else if (finding.rootSpeed > settings.teleportSpeedLimit || finding.turnSpeed > settings.teleportTurnLimit) {
+			carry(bones, delta);
+			finding.action = Action::kCarried;
+		}
+
+		return finding;
+	}
+
+	void DiscontinuityGuard::carry(const Bones& bones, const btTransform& delta)
+	{
+		const auto& turn = delta.getBasis();
+		for (const auto& bone : bones) {
+			auto& rig = bone->m_rig;
+			const btTransform moved = delta * rig.getWorldTransform();
+			rig.setWorldTransform(moved);
+			rig.setInterpolationWorldTransform(moved);
+
+			// Animated bones get their velocity from the read that follows.
+			if (!rig.isStaticOrKinematicObject()) {
+				const btVector3 linear = turn * rig.getLinearVelocity();
+				const btVector3 angular = turn * rig.getAngularVelocity();
+				rig.setLinearVelocity(linear);
+				rig.setAngularVelocity(angular);
+				rig.setInterpolationLinearVelocity(linear);
+				rig.setInterpolationAngularVelocity(angular);
+			}
+		}
+	}
+}
diff --git a/src/hdtDiscontinuityGuard.h b/src/hdtDiscontinuityGuard.h
new file mode 100644
index 0000000..ead5604
--- /dev/null
+++ b/src/hdtDiscontinuityGuard.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include "hdtSkinnedMesh/hdtBulletHelper.h"
+#include "hdtSkinnedMesh/hdtSkinnedMeshBone.h"
+
+namespace hdt
+{
+	// Limits above which the motion of a skeleton between two physics reads is not something the
+	// simulation can follow. Speeds are measured against the simulated time of the step, which is what
+	// the solver sees: a long frame squeezed into maxSubSteps ticks counts as fast motion.
+	struct DiscontinuitySettings
+	{
+		bool enabled = true;
+		// Skyrim units per second of the skeleton root. Above it the actor was teleported (or a long
+		// frame was compressed), and the bodies are carried along instead of being dragged.
+		float teleportSpeedLimit = 1500.0f;
+		// Degrees per second of the skeleton root, same treatment.
+		float teleportTurnLimit = 2000.0f;
+		// Skyrim units per second of an animated bone relative to the root. When half of the animated
+		// bones exceed it, the pose was swapped and the system restarts from its rest shape.
+		float poseSnapSpeedLimit = 1200.0f;
+		// A system that was just built (outfit equipped, actor loaded) starts in its rest shape, which
+		// only fits a body that is not in the middle of a pose change. It is kept at rest until no
+		// animated bone moves faster than this relative to the root (Skyrim units per second)...
+		float settleSpeedLimit = 100.0f;
+		// ...or until this many seconds have passed, for actors that never stand still.
+		float settleTimeLimit = 1.5f;
+	};
+
+	// Watches one system's skeleton root and animated bones from read to read. The simulation turns
+	// every change of an animated bone into a velocity; a teleport, a placement after a loading screen or
+	// a swapped pose would become a sweep of the body through its own cloth, which then stays on the
+	// wrong side. The guard removes such a jump before the bones are read, and keeps a new system at
+	// rest while the body is still moving into its pose.
+	class DiscontinuityGuard
+	{
+	public:
+		enum class Action
+		{
+			kNone,
+			kCarried,  // bodies were moved rigidly with the root; simulation state is kept
+			kRestart,  // the caller must reset the system
+			kHold      // still settling: the caller must reset the system
+		};
+
+		struct Finding
+		{
+			Action action = Action::kNone;
+			float rootSpeed = 0.0f;  // units per second
+			float turnSpeed = 0.0f;  // degrees per second
+			float poseSpeed = 0.0f;  // fastest animated bone relative to the root, units per second
+			int snappedBones = 0;
+			int animatedBones = 0;
+			bool released = false;  // settling ended with this read
+			float heldFor = 0.0f;   // seconds spent settling, valid with kHold or released
+		};
+
+		using Bones = std::vector<RE::BSTSmartPointer<SkinnedMeshBone>>;
+
+		// Forgets the previous read: the next one is compared against `root`.
+		void restart(const btTransform& root);
+
+		// The system was just built or attached to another scene graph: hold it at rest until its pose
+		// has settled.
+		void settle();
+
+		// Compares this read against the previous one and carries the bodies along if the root jumped.
+		Finding inspect(const Bones& bones, const btTransform& root, float timeStep, const DiscontinuitySettings& settings);
+
+	private:
+		static void carry(const Bones& bones, const btTransform& delta);
+
+		btTransform m_lastRoot = btTransform::getIdentity();
+		bool m_tracking = false;
+		bool m_settling = false;
+		float m_heldFor = 0.0f;
+		float m_calmFor = 0.0f;
+	};
+	// Layout-preserving storage. Other plugins (Banner Physics) verify the exact size and field offsets of
+	// hdt::SkyrimSystem and hdt::SkyrimPhysicsWorld from the PDB, so the guard state is kept outside those
+	// classes instead of as members.
+	DiscontinuitySettings& GetDiscontinuitySettings();
+	DiscontinuityGuard& GetDiscontinuityGuard(const void* owner);
+}
